# Required: Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Recommended when exposing the server through a tunnel: any long random string.
# Open the app once with ?key=<ACCESS_TOKEN>; the browser remembers it.
ACCESS_TOKEN=

# Deploying the phone prototype to HoboHost over FTP (used by the deploy script).
# FTP_HOST: the server name from cPanel > FTP Accounts > "Configure FTP Client".
# FTP_USER: the full FTP username, usually like name@yourdomain.com.
# FTP_DIR: the folder the page goes into, relative to the FTP account's home
#   (e.g. public_html/guide, or / if the account is already limited to that folder).
# FTP_URL: the web address that folder is served at, e.g. https://yourdomain.com/guide
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_DIR=
FTP_URL=

# Optional overrides
# NARRATION_MODEL=claude-sonnet-5-5
# PORT=8787
