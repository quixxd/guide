{
  "name": "guide",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype of a personal audio tour guide for walks and drives",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.ts",
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "tunnel": "cloudflared tunnel --url http://localhost:8787"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
